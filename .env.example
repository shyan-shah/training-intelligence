# Copy to .env for local work. .env is gitignored and must stay that way.
# In CI every one of these is a GitHub Actions secret instead.

# --- Supabase (the Vault project) -----------------------------------------
# Only needed to run the migrations and seeds, by the Bootstrap workflow or
# by psql locally. The app and the ingest never use it.
SUPABASE_DB_URL=

# The service key bypasses RLS. It belongs in Actions secrets and nowhere else:
# never in the web app, never in a commit, never in a log line.
SUPABASE_URL=https://drdvfdwxjgbqpnnqfzgg.supabase.co
SUPABASE_SERVICE_KEY=
# The auth.users id that owns every row. Server-side writes must pass this
# explicitly, because the column default is auth.uid() and the service role
# has no auth.uid().
TI_USER_ID=

# --- Web app (safe to expose; RLS is what protects the data) ---------------
NEXT_PUBLIC_SUPABASE_URL=https://drdvfdwxjgbqpnnqfzgg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Garmin, login route (the primary source) ------------------------------
# The same email and password as the Garmin Connect app. Covers sleep, HRV,
# resting HR, body battery, stress, steps, body composition, activities, and
# the training metrics the official Personal tier does not expose at all
# (readiness, training status, acute and chronic load, VO2max).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Garmin, official Personal API (optional alternative) ------------------
# Leave blank unless you want an officially supported path as well. It covers
# strictly less than the login route, needs a developer account and key
# approval, and its endpoint paths are unverified until a key is issued.
# Read the Personal tier terms at sign up: see the Garmin terms note in the
# README before shipping any AI narrative.
GARMIN_PERSONAL_TOKEN=

# --- Strava ----------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# --- Evolt vision fallback (only used when a PDF has no text layer) --------
ANTHROPIC_API_KEY=

# --- Push ------------------------------------------------------------------
NTFY_TOPIC=
# Leave at 0. The relay is public, so no health number may go through it.
NTFY_INCLUDE_SENSITIVE=0
